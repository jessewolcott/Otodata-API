# ── Source junk ────────────────────────────────────────────────────────────
*.pdf

# ── Downloaded reports ─────────────────────────────────────────────────────
*.csv
*.xlsx

# ── Postman files (may contain credentials) ───────────────────────────────
*.postman_collection.json
*.postman_environment.json
